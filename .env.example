# Copy to .env and fill in. Never commit .env.

# --- backend ---
# Postgres connection (local: docker-compose.yml; production: existing VPS Postgres, see docs/INFRA.md)
DATABASE_URL=postgresql://ride:ride@localhost:5432/ride
# Test database (wiped by tests)
DATABASE_URL_TEST=postgresql://ride:ride@localhost:5432/ride_test
# JWT signing secret; any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# HTTP bind address and port (production: HTTP_HOST=127.0.0.1, see docs/INFRA.md)
HTTP_HOST=0.0.0.0
PORT=3000

# --- mobile (put these in frontend/apps/consumer/.env and frontend/apps/rider/.env) ---
# Backend URL as seen from the phone: laptop LAN IP for dev, https://api.<domain> for the deployed backend
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
# Google Maps key for Android dev builds (iOS uses Apple Maps)
GOOGLE_MAPS_API_KEY=
